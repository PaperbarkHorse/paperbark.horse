---
import Paper from "$components/containers/Paper.astro";
import StickyNote from "$components/containers/StickyNote.astro";
import ArrowButton from "$components/elements/buttons/ArrowButton.astro";
import Content from "$components/elements/text/Content.astro";
import PaperTitle from "$components/elements/text/PaperTitle.astro";
import PolaroidGrid from "$components/layouts/polaroid-grid/PolaroidGrid.astro";
import PolaroidGridItem from "$components/layouts/polaroid-grid/PolaroidGridItem.astro";
import NavItem from "$components/navigation/NavItem.astro";
import NavSection from "$components/navigation/NavSection.astro";
import ContentPage from "$layouts/ContentPage.astro";
---

<ContentPage title="My OCs">
    <Fragment slot="navigation">
        <NavSection name="Navigation">
            <NavItem name="Home" href="/" />
        </NavSection>
    </Fragment>

    <Fragment slot="contents">
        <NavSection name="On This Page">
            <NavItem name="My OCs" href="#my-ocs" />
        </NavSection>
    </Fragment>

    <Fragment slot="main">
        <StickyNote>
            <Content>
                <h2>Work in Progress</h2>
                <p>
                    I'm still working on this section, so a lot of stuff is either incomplete or doesn't have
                    a proper page yet! Be sure to check back again soon when more things are finished.
                </p>
                <p>- Paperbark /)</p>
            </Content>
        </StickyNote>
        <Paper>
            <PaperTitle el="h1" title="My OCs" />
            <Content>
                <PolaroidGrid>
                    <PolaroidGridItem
                        title="Paperbark"
                        src="/images/ocs/paperbark/profile.jpg"
                        href="/ocs/paperbark"
                        angle="-3deg"
                    />
                    <PolaroidGridItem
                        title="Quasar"
                        src="/images/ocs/quasar/profile.jpg"
                        angle="1deg"
                        href="https://toyhou.se/39037381.quasar"
                    />
                    <PolaroidGridItem
                        title="Cocoa Butter"
                        src="/images/ocs/cocoa-butter/profile.jpg"
                        angle="-1deg"
                        href="https://toyhou.se/39048266.cocoa-butter"
                    />
                    <PolaroidGridItem
                        title="Gasoline"
                        src="/images/ocs/gasoline/profile.jpg"
                        angle="3deg"
                        href="https://toyhou.se/39065970.gasoline"
                    />
                    <PolaroidGridItem
                        title="Maple Scruff"
                        src="/images/ocs/maple-scruff/profile.jpg"
                        angle="-2deg"
                    />
                </PolaroidGrid>
                <div class="button-container">
                    <ArrowButton href="https://toyhou.se/Paperbark">Visit my Toyhouse</ArrowButton>
                </div>
            </Content>
        </Paper>
    </Fragment>
</ContentPage>
