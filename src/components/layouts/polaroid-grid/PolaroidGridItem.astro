---
import Polaroid from "$components/elements/images/Polaroid.astro";

interface Props {
    src: string;
    href?: string;
    title?: string;
    angle?: string;
    external?: boolean;
}

let { src, href, title, angle, external } = Astro.props;

if (href && external === undefined) {
    let url = new URL(href, Astro.url);
    external = url.host !== Astro.url.host;
}
---

<a
    href={href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
    class="polaroid-grid-item group"
>
    <Polaroid {src} dynamic={href !== undefined} {angle} />
    {title && <span class="item-title">{title}</span>}
</a>

<style lang="scss">
    .polaroid-grid-item {
        display: flex;
        flex-direction: column;
        align-items: center;

        padding: 0.7rem 0.5rem;
        gap: 1rem;

        .item-title {
            line-height: 1.1;
            font-weight: var(--font-semibold);
            text-align: center;
        }
    }
</style>
