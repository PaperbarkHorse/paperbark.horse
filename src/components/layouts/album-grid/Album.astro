---
import StickyNote from "$components/containers/StickyNote.astro";

interface Props {
    title?: string;
    artist?: string;
    summary?: string;
    cover?: string;
    href?: string;
    external?: boolean;
    disabled?: boolean;
    label?: string;
}

let { title, artist, summary, cover, href, external, disabled = false, label } = Astro.props;

if (href && external === undefined) {
    let url = new URL(href, Astro.url);
    external = url.host !== Astro.url.host;
}
---

<a
    class:list={["album", { disabled }]}
    href={disabled ? undefined : href}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
>
    {cover ? <img src={cover} alt="" class="cover" /> : <div class="placeholder-cover">{title}</div>}
    {
        label && (
            <div class="label-container">
                <div class="label">
                    <StickyNote padding={false}>
                        <div class="label-content">{label}</div>
                    </StickyNote>
                </div>
            </div>
        )
    }
    <div class="details">
        {title && <span class="title">{title}</span>}
        {artist && <span class="artist">{artist}</span>}
        {summary && <span class="summary">{summary}</span>}
    </div>
</a>

<style lang="scss">
    .album {
        position: relative;

        display: flex;
        flex-direction: column;
        container-type: inline-size;

        gap: 0.8rem;

        .cover,
        .placeholder-cover {
            box-shadow: var(--shadow-medium);
            transform: scale(100%);
            z-index: 0;

            user-select: none;

            transition-property: box-shadow, transform, z-index;
            transition-duration: 0.15s;
        }

        &.disabled .cover,
        &.disabled .placeholder-cover {
            opacity: 0.33;
        }

        &:not(.disabled):hover,
        &:not(.disabled):focus-visible {
            .cover,
            .placeholder-cover {
                box-shadow: var(--shadow-large);
                transform: scale(105%);
                z-index: 50;
            }
        }

        .cover {
            border-radius: 0.25rem;

            aspect-ratio: 1;
            object-fit: cover;
        }

        .placeholder-cover {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            padding: 5cqw;

            border: 5cqw solid #ffe300;
            border-radius: 0.25rem;

            background-color: white;

            font-size: 12cqw;
            font-weight: var(--font-medium);
            text-align: center;

            aspect-ratio: 1;
            object-fit: cover;
        }

        .label-container {
            --sticky-note-fold-size: 6cqw;

            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            aspect-ratio: 1/1;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;

            user-select: none;

            .label {
                margin: 5cqw;
                transform: rotate(-10deg);
            }

            .label-content {
                padding: 4cqw 10cqw;

                font-size: 10cqw;
                font-weight: var(--font-medium);
                text-align: center;
            }
        }

        .details {
            display: flex;
            flex-direction: column;
            align-items: center;

            gap: 0.25rem;

            text-align: center;
            line-height: 1.1;
        }

        .title {
            font-weight: var(--font-semibold);
        }

        .summary:not(:first-child) {
            margin-top: 0.2rem;
            line-height: 1.25;
        }
    }
</style>
