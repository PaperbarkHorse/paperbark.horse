---
import StickyNote from "$components/containers/StickyNote.astro";
import Flow from "$components/elements/text/Flow.astro";
---

<div class="note">
    <StickyNote>
        <Flow>
            <slot />
        </Flow>
    </StickyNote>
</div>

<style lang="scss">
    .note {
        padding-inline: 1rem;
    }
</style>
