---
interface Props {
    date: string | Date;
}

let { date } = Astro.props;

if (typeof date === "string") {
    date = new Date(date);
}
---

<time datetime={date.toISOString()}
    >{
        date.toLocaleDateString("en-GB", {
            day: "numeric",
            month: "long",
            year: "numeric",
        })
    }</time
>
