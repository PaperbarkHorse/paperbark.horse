---
import "$styles/site.scss";
import "$styles/fonts/lexend.scss";
import VisitorCounter from "$components/site/visitors/VisitorCounter.svelte";
import Lightbox from "$components/site/lightbox/Lightbox.svelte";

interface Props {
    title?: string;
    bodyClass?: string;
    lightbox?: boolean;
}

let { title, bodyClass, lightbox = true } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" type="image/vnd.microsoft.icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        {title ? <title>{title} - Paperbark</title> : <title>Paperbark</title>}

        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <VisitorCounter key="paperbark.horse" client:only="svelte" />
        <slot />
        {lightbox && <Lightbox client:only="svelte" />}
    </body>
</html>
